# .env.local.example
# Copiar como .env.local y completar con tus valores reales.
# En Vercel: Project Settings > Environment Variables

# ID de la hoja de Google Sheets (se encuentra en la URL entre /d/ y /edit)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# API Key de Google Cloud con Sheets API v4 habilitada (modo lectura pública)
GOOGLE_SHEETS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Número de WhatsApp de la tienda (formato internacional sin +)
NEXT_PUBLIC_WPP_NUMBER=51999999999

# URL pública del sitio (para SEO y sitemap)
NEXT_PUBLIC_SITE_URL=https://monkysstore.pe

# Secreto para la revalidación bajo demanda (/api/revalidate).
# Inventa una cadena larga y aleatoria. El MISMO valor va en el Apps Script
# (Propiedades del script > REVALIDATE_SECRET).
REVALIDATE_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
